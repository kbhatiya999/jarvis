<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps a voice session going if the screen locks mid-conversation. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- Background check of the relay for messages from other Jarvises. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kbhatiya999.jarvis.relay-poll</string>
	</array>
</dict>
</plist>
